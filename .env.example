# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Current naming (preferred): publishable key + secret key (Notebook v2 §12)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallback (still accepted): ANON_KEY / SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL used for sitemap/robots/canonical/OG (no trailing slash). Set to your production domain when publishing.
NEXT_PUBLIC_SITE_URL=https://agenda.example.com

# Demo mode — explicit only (Notebook v3 §2.2). When true, /api/* returns mock demo-workspace data without DB/Supabase.
# Never enable in production; missing infra must fail closed (500), not pretend empty.
TEMPO_DEMO_MODE=false

# Prisma — pooled connection for the running app (Supabase "Connection pooling" URI)
# Never expose DATABASE_URL / DIRECT_URL / SUPABASE_SECRET_KEY to the client bundle.
DATABASE_URL=
# Prisma CLI — direct connection, used only for migrate/introspect
DIRECT_URL=
